{
  "name": "mcp-agent-accelerator",
  "version": "0.1.0",
  "description": "A flexible framework that helps AI agents connect seamlessly with real world data and tools using the Model Context Protocol",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "dashboard": "cd nexus-dashboard && npm run dev",
    "dashboard:build": "cd nexus-dashboard && npm run build",
    "dashboard:start": "cd nexus-dashboard && npm run start",
    "dashboard:install": "cd nexus-dashboard && npm install",
    "dashboard:lint": "cd nexus-dashboard && npm run lint"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "model-context-protocol",
    "automation",
    "typescript",
    "nextjs",
    "dashboard",
    "anthropic",
    "claude",
    "salesforce",
    "data-warehouse"
  ],
  "author": "A Taylor",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@octokit/rest": "^20.0.0",
    "openai": "^4.0.0",
    "zod": "^3.22.0",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ATaylorAerospace/MCP-Agent-Accelerator.git"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.ts", "**/?(*.)+(spec|test).ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
